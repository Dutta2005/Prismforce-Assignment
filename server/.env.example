PORT=8000
CLIENT_ORIGIN=http://localhost:5173

# Google AI Studio / Gemini Developer API
GEMINI_API_KEY=<your_gemini_api_key>
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Chroma Cloud
CHROMA_API_KEY=<your_chroma_api_key>
CHROMA_TENANT=<your_chroma_tenant>
CHROMA_DATABASE=<your_chroma_db>
CHROMA_HOST=api.trychroma.com
CHROMA_PORT=443
CHROMA_COLLECTION=hr_policy_chunks_local

# Retrieval safety knobs
TOP_K=6
DISTANCE_THRESHOLD=1.45
CHUNK_TARGET_CHARS=1400
CHUNK_OVERLAP_CHARS=180
